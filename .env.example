NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
MOCK_PORTAL_URL=http://127.0.0.1:3002
MOCK_PORTAL_PORT=3002

# Local development uses an embedded PostgreSQL database and private files in .data.
# Hosted production uses the Supabase PostgreSQL connection string and private Storage.
DATABASE_URL=
# Optional dedicated worker login. It must be a member of the migration-created janaseva_ingestor role.
# Worker connections SET ROLE janaseva_ingestor and cannot read citizen accounts, profiles or drafts.
INGESTION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=documents

# Mandatory in production. Generated and persisted locally when left blank.
JWT_SECRET=
PORTAL_SECRET=

# Optional hosted intelligence. Local policy lookup works with indexed Ministry excerpts.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Windows prefers installed Chrome and falls back to Edge. Linux/macOS use Playwright Chromium.
BROWSER_CHANNEL=
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=15000
OCR_LANG_PATH=
POLICY_INGEST_KEY=

# Scheme monitor runs while the backend is running. Admin APIs require a verified administrator.
SCHEME_MONITOR_ENABLED=true
SCHEME_MONITOR_KEY=

# Optional search key for discovery. Tavily is used when both providers are configured.
TAVILY_API_KEY=
# Existing Brave Search API key.
SCHEME_SEARCH_API_KEY=
SCHEME_CATALOG_ENABLED=true
SCHEME_ENRICHMENT_ENABLED=true
SCHEME_CATALOG_AUTO_PUBLISH=true
SCHEME_SYNC_WORKER=false

# Default administrator signs in directly without email verification.
# Set both on Render; Adminmail must be email-shaped but does not require a real inbox.
Adminmail=
AdminPass=

# Server-side authentication email. Use a verified sender; never set these as VITE_* variables.
# Render Free blocks SMTP 465/587. Brevo supports STARTTLS on port 2525.
# Optional: when present, Brevo HTTPS API is used instead of SMTP. Server-side API key, not SMTP key.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_PUBLIC_URL=https://frontend-alpha-five-81.vercel.app
EMAIL_VERIFY_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
AUTH_EMAIL_COOLDOWN_SECONDS=60
PENDING_REGISTRATION_DAYS=30

# Defaults to 1 on Render, 0 locally. Set 1 explicitly if overriding this key on Render.
TRUST_PROXY_HOPS=0
